# InterviewAI API — Backend Environment Variables
#
# Copy this file to .env and fill in real values.
# NEVER commit .env (rule.md §5).

ENVIRONMENT=development
FRONTEND_ORIGIN=http://localhost:3000

# ── Supabase (legacy — retained for storage/DB integration) ─────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# ── Firebase Auth + Cloud Storage ────────────────────────────────────────
# Either paste the full service-account JSON on one line, or set
# GOOGLE_APPLICATION_CREDENTIALS_PATH to the downloaded JSON file path.
FIREBASE_PROJECT_ID=interv-ai-880ac
FIREBASE_SERVICE_ACCOUNT_JSON=
GOOGLE_APPLICATION_CREDENTIALS_PATH=
# Cloud Storage bucket for user files (resumes, images). Same service account
# is used — no separate API key. Find it in Firebase Console → Storage.
FIREBASE_STORAGE_BUCKET=interv-ai-880ac.firebasestorage.app

# Comma-separated admin allowlist (admin auth requires verified email + MFA)
ADMIN_EMAILS=

# ── Database ─────────────────────────────────────────────────────────────
# Postgres URI in prod; sqlite for local dev.
DATABASE_URL=sqlite+aiosqlite:///./interviai.db

# ── Gemini AI (server-only — powers resume analysis, communication coach,
# and Gemini Live ephemeral tokens for real-time voice coaching) ──────────
# Get a key at https://aistudio.google.com/apikey  →  "Get API key"
GEMINI_API_KEY=
# Optional override. Default is gemini-3.1-pro-preview.
GEMINI_MODEL=gemini-3.1-pro-preview

# ── Theirstack job data (server-only) ───────────────────────────────────
THEIRSTACK_API_KEY=

# ── Outbound email (welcome message after onboarding) ───────────────────
# Uses SMTP_USER as the sender identity. For Gmail: enable 2-Step Verification,
# then create an App Password at https://myaccount.google.com/apppasswords
# and paste it as SMTP_PASSWORD (16 characters, no spaces).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=vp4647115@gmail.com
SMTP_PASSWORD=
ADMIN_EMAIL=vp4647115@gmail.com
EMAIL_FROM_NAME=InterviewAI
APP_URL=http://localhost:3000
