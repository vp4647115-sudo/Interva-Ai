# InterviewAI API environment — copy to .env and fill in real values.
# NEVER commit .env (rule.md §5).
ENVIRONMENT=development
FRONTEND_ORIGIN=http://localhost:3000

# Firebase Auth — either paste the service-account JSON below, or set
# GOOGLE_APPLICATION_CREDENTIALS_PATH to the downloaded JSON file path.
FIREBASE_PROJECT_ID=interv-ai-880ac
FIREBASE_SERVICE_ACCOUNT_JSON=
GOOGLE_APPLICATION_CREDENTIALS_PATH=

# Comma-separated admin allowlist (admin auth requires verified email + MFA)
ADMIN_EMAILS=vp4647115@gmail.com

# Postgres connection string (async driver). Get this from Supabase →
# Project Settings → Database → Connection string (URI), use port 6543 pooler or 5432 direct.
DATABASE_URL=sqlite+aiosqlite:///./interviai.db